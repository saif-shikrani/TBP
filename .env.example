# Runtime
NODE_ENV=development
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
LOG_LEVEL=info

# PostgreSQL (required by the database package when used)
DATABASE_URL=postgresql://tbp:tbp@localhost:5432/tbp?schema=public

# Redis (optional for the local health endpoint; required by workers/realtime)
REDIS_URL=redis://localhost:6379

# Authentication (server-only)
AUTH_SECRET=replace-with-a-long-random-secret
AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Provider integrations (add only when the corresponding milestone is enabled)
TELNYX_API_KEY=
TELNYX_PUBLIC_KEY=
TELNYX_WEBHOOK_SECRET=
OPENAI_API_KEY=
TALLY_API_KEY=
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
